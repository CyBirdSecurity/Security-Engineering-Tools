    {"name": "AWS S3", "cname": ["\\.s3[.-]([a-z0-9-]+\\.)?amazonaws\\.com$", "\\.s3-website[.-][a-z0-9-]+\\.amazonaws\\.com$", "^s3[.-]([a-z0-9-]+\\.)?amazonaws\\.com$"], "nxdomain": false, "http": ["NoSuchBucket", "The specified bucket does not exist"], "status": "vulnerable"},
